rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cobranças PIX. O cliente só LÊ o status do seu pagamento pelo id
    // (id do Mercado Pago, não-adivinhável). NINGUÉM grava pelo cliente —
    // apenas as Cloud Functions (admin SDK) escrevem o status. Isso impede
    // que alguém falsifique "approved" e libere o relatório sem pagar.
    match /payments/{paymentId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // PII (email/nome) — NUNCA legível pelo cliente. Só as Cloud Functions
    // (admin SDK) acessam. Mantém os dados pessoais fora do alcance público.
    match /payment_private/{paymentId} {
      allow read, write: if false;
    }

    // Avaliações pós-leitura (pop-up do relatório). O cliente só CRIA, com
    // validação estrita; ninguém lê/edita pelo cliente (curadoria via console
    // antes de virar depoimento público).
    match /reviews/{reviewId} {
      allow create: if request.resource.data.keys().hasOnly(['rating','comentario','nome','profileKey','paymentId','createdAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 600
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
        && request.resource.data.profileKey is string && request.resource.data.profileKey.size() <= 60
        && request.resource.data.paymentId is string && request.resource.data.paymentId.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Bloqueia o resto por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
